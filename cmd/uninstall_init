#!/bin/bash
#
# 下载中心接入Aria2 — 卸载前回调：兜底停进程，透转向导选择
#
set -uo pipefail
LOG="${TRIM_TEMP_LOGFILE:-/dev/null}"
log() { echo "[aria2bridge] $1" > "$LOG" 2>/dev/null || true; }
pkill -f "@appcenter/aria2bridge.*bridge\.py" 2>/dev/null || true
if [ "${wizard_delete_data:-no}" = "yes" ]; then
    log "用户选择完全删除：将清理配置（含飞牛账号密码）与日志"
else
    log "用户选择保留数据：config.json 与日志保留"
fi
exit 0
